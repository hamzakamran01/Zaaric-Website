# EmailJS Configuration
# Get your credentials from https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Optional: separate template for CareOps design-partner requests, so motel
# leads don't land in the same thread as agency inquiries.
# Falls back to VITE_EMAILJS_TEMPLATE_ID when unset.
VITE_EMAILJS_CAREOPS_TEMPLATE_ID=your_careops_template_id_here
